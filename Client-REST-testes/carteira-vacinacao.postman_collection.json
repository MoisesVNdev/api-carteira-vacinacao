            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Ana Silva Santos\",\n  \"dataNascimento\": \"2020-01-01\",\n  \"cns\": \"898001160000000\",\n  \"cpf\": \"12345678901\",\n  \"nomeMae\": \"Maria da Silva\",\n  \"genero\": \"FEMININO\",\n  \"nacionalidade\": \"Brasileira\",\n  \"naturalidade\": \"Sao Paulo\",\n  \"tipoSanguineo\": \"O+\",\n  \"foto\": \"https://exemplo.com/foto-ana.jpg\",\n  \"tipoRelacao\": \"FILHA\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pessoas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pessoas"]
            },
            "description": "Maria cadastra sua filha Ana no sistema.\n✅ Resposta esperada: 201 Created\n🔐 Requer autenticação: Bearer {{tokenMaria}}\n💡 ID de Ana capturado automaticamente em {{anaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"anaId capturado com sucesso\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.not.be.undefined;",
                  "    pm.collectionVariables.set(\"anaId\", json.id);",
                  "    console.log(\"✅ anaId salvo:\", json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
