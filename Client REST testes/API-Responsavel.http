@baseUrl   = http://localhost:8080
@usuarioId = 1

# =============================================================================
# SEÇÃO 1 — REGISTRO  ·  POST /auth/register  (público)
# =============================================================================

### [AUTH] Registrar responsável (criar usuário)
# Espera: 201 Created
# @name registrarResponsavel

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "nomeCompleto": "João Silva",
    "email": "joao.silva@email.com",
    "senha": "Senha@2024"
}

###

# =============================================================================
# SEÇÃO 2 — LOGIN  ·  POST /auth/login  (público)
# =============================================================================

### [AUTH] Login para obter token
# Espera: 200 OK com token JWT
# @name loginAPI

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "joao.silva@email.com",
    "senha": "Senha@2024"
}

###

@token = {{loginAPI.response.body.token}}

# =============================================================================
# SEÇÃO 3 — API RESPONSÁVEL  ·  Endpoints protegidos
# Controller: ResponsavelController.java
# =============================================================================

### [POST] 3.1 - Criar responsável
# Espera: 201 Created
# Execute o login (2.1) antes para garantir que {{token}} está preenchido.

POST {{baseUrl}}/api/responsaveis
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "usuarioId": {{usuarioId}},
  "pessoaId": 1,
  "parentesco": "Pai"
}

###

### [GET] 3.2 - Listar responsáveis por usuário
# Espera: 200 OK com array de responsáveis

GET {{baseUrl}}/api/responsaveis/usuario/{{usuarioId}}
Authorization: Bearer {{token}}

###

### [GET] 3.3 - Buscar responsável por ID
# Espera: 200 OK ou 404 Not Found

GET {{baseUrl}}/api/responsaveis/1
Authorization: Bearer {{token}}

###

### [PUT] 3.4 - Atualizar responsável
# Espera: 200 OK ou 404 Not Found
# Altere o ID conforme necessário

PUT {{baseUrl}}/api/responsaveis/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "usuarioId": {{usuarioId}},
  "pessoaId": 1,
  "parentesco": "Mãe"
}

###

### [DELETE] 3.5 - Deletar responsável
# Espera: 204 No Content ou 404 Not Found

DELETE {{baseUrl}}/api/responsaveis/1
Authorization: Bearer {{token}}
