# ============================================================================
# ARQUIVO DE EXEMPLO - VARIÁVEIS DE AMBIENTE
# ============================================================================
# Este arquivo serve como template para o arquivo .env
# 
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores das variáveis no arquivo .env
# 3. O arquivo .env não deve ser commitado no Git
# ============================================================================

# ----------------------------------------------------------------------------
# PROJETO
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=carteira-vacinacao-api

# ----------------------------------------------------------------------------
# POSTGRESQL
# ----------------------------------------------------------------------------
POSTGRES_DB=carteira_vacinacao_db
POSTGRES_USER=carteira_user
POSTGRES_PASSWORD=ALTERE_ESTA_SENHA_AQUI
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# APLICAÇÃO SPRING BOOT
# ----------------------------------------------------------------------------
SPRING_PROFILE=dev
APP_PORT=8080
DEBUG_PORT=5005

# ----------------------------------------------------------------------------
# JPA/HIBERNATE
# ----------------------------------------------------------------------------
# O schema é gerenciado pelo Flyway: o Hibernate não deve alterá-lo.
# none = não mexe no schema | validate = só confere se as entidades batem com o banco
# Nunca use "update" junto com Flyway.
JPA_DDL_AUTO=none
JPA_SHOW_SQL=true

# ----------------------------------------------------------------------------
# TIMEZONE
# ----------------------------------------------------------------------------
TZ=America/Sao_Paulo

# ----------------------------------------------------------------------------
# JWT (SEGURANÇA)
# ----------------------------------------------------------------------------
# Secret key para assinatura do JWT
# IMPORTANTE: precisa ser um valor em BASE64 com no mínimo 32 bytes (256 bits).
# Um texto comum (com "_" por exemplo) faz o login falhar.
# Comando para gerar: openssl rand -base64 64
JWT_SECRET=

# Tempo de expiração do token em milissegundos
# 86400000 ms = 24 horas
# 3600000 ms = 1 hora
JWT_EXPIRATION=86400000

# ============================================================================
# DICAS DE SEGURANÇA:
# ============================================================================
# 1. Gere uma senha forte para POSTGRES_PASSWORD
#    Comando: openssl rand -base64 32
#
# 2. Nunca commite o arquivo .env com credenciais reais
#
# 3. Use diferentes credenciais para cada ambiente (dev, staging, prod)
#
# 4. Considere usar ferramentas de gerenciamento de secrets:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#    - 1Password / LastPass (para desenvolvimento local)
# ============================================================================
